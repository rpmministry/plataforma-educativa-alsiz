# ===== JERARQUÍA DE IA =====
# ★ DEEPSEEK_API_KEY: CAPA PRINCIPAL (plan de pago). Créala en https://platform.deepseek.com/api_keys
#   Formato: sk-...  ·  Se coloca SOLO en .env.local (local) y en Vercel → Settings → Environment Variables.
#   Mientras exista, DeepSeek responde primero y las capas gratuitas quedan como respaldo.
DEEPSEEK_API_KEY=

# DEEPSEEK_MODEL: modelo principal. 'deepseek-chat' (rápido, recomendado) o 'deepseek-reasoner' (razonamiento).
# DEEPSEEK_BASE_URL: por defecto https://api.deepseek.com/v1 (API compatible con OpenAI).
# DEEPSEEK_MODEL=deepseek-chat
# DEEPSEEK_BASE_URL=https://api.deepseek.com/v1

# GEMINI_API_KEY: Última capa (free tier de https://aistudio.google.com/apikey, formato AIza… o AQ.…; NUNCA un OAuth Client ID …apps.googleusercontent.com).
GEMINI_API_KEY=

# OPENROUTER_API_KEY: Respaldo 1 — caza dinámica de modelos ":free" (gratis). Crea la key gratis en https://openrouter.ai/settings/keys.
OPENROUTER_API_KEY=

# OPENCODE_API_KEY: Respaldo 2 — catálogo "-free" de OpenCode Zen (gratuito). Sin esta clave la capa se omite automáticamente.
OPENCODE_API_KEY=

# APP_URL: URL de la aplicación (Inyectada automáticamente por el entorno)
APP_URL=

# --- Ajustes opcionales de la jerarquía ---
# AI_MODEL_TIMEOUT_MS=6000    (presupuesto por intento de modelo: "hasta que conteste o pasen 6 s → siguiente modelo")
# AI_TIER_BUDGET_MS=20000     (techo de tiempo por capa de caza)
# AI_LAST_TIER_BUDGET_MS=12000
# AI_TIER1_MODEL=model-a:free,model-b:free   (fuerza cola concreta en vez del catálogo dinámico)
# AI_TIER2_MODEL=deepseek-v4-flash-free,mimo-v2.5-free
# AI_TIER3_MODEL=gemini-3.7-flash,gemini-3.6-flash
# AI_FREE_MODEL_MAX=8         (cuántos modelos free se encolan)
# AI_PAID_MODEL=             (OPCIONAL: define p. ej. qwen/qwen3.8-flash para añadir una capa premium AL FINAL; por defecto nada de pago)
# VITE_AI_SERVER_TIMEOUT_MS=25000  (capa cliente: cuánto esperar al server antes de su cascada gratuita local)

# ===== BASE DE DATOS Y PERSISTENCIA (ETAPA 05) =====
# Ruta del archivo SQLite relacional (por defecto en ./data/alsiz.db)
DATABASE_PATH=./data/alsiz.db

# Secreto criptográfico para firma y derivación de tokens de sesión (mínimo 32 caracteres)
SESSION_SECRET=alsiz_ekballo_session_secret_change_in_production_2026_min32bytes

# Tiempo de vida de sesiones en horas (por defecto 72 horas)
SESSION_TTL_HOURS=72

# Entorno de ejecución: development | production | test
NODE_ENV=development
PORT=3000
