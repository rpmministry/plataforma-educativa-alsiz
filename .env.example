# ==============================================================================
# PLANTILLA MAESTRA DE VARIABLES DE ENTORNO (.env.example)
# Plataforma Educativa ALSIZ — Ekballo Church
# ==============================================================================
#
# POLÍTICA DE SEGURIDAD (P0):
# 1. NUNCA coloque claves API, contraseñas, secretos o PINs en este archivo ni en Git.
# 2. Las claves de IA, SESSION_SECRET y credenciales de correo van ÚNICAMENTE en el
#    entorno del BACKEND persistente.
# 3. NUNCA agregue variables con prefijo VITE_* que contengan secretos; cualquier
#    variable VITE_* es empaquetada públicamente en el bundle JavaScript del navegador.
# ==============================================================================

# ==============================================================================
# SECCIÓN A: ENTORNO VERCEL (FRONTEND ESTÁTICO + SERVERLESS TURSO O PROXY)
# ==============================================================================
# Configurar estas variables en el panel de Vercel (Project Settings -> Environment Variables):
#
# CASO 1: Despliegue Vercel + Turso Cloud Serverless ($0.00 USD/mes - Recomendado)
# Configurar aquí: TURSO_DATABASE_URL, TURSO_AUTH_TOKEN, SESSION_SECRET, GEMINI_API_KEY, RESEND_API_KEY
#
# CASO 2: Despliegue Vercel CDN + Backend Persistente Node.js (Render / VPS)
# URL del backend persistente donde se reenvían las peticiones /api/* (dejar vacío si usa Turso)
# Ejemplo en producción: https://alsiz-backend.onrender.com o https://api.ekballochurch.org
BACKEND_URL=

# Variables públicas de frontend (opcionales; prefijo VITE_):
# VITE_APP_TITLE="Plataforma Educativa ALSIZ"
# VITE_PUBLIC_URL=https://educacion.ekballochurch.org

# ==============================================================================
# SECCIÓN B: ENTORNO DEL BACKEND PERSISTENTE (Node 22 LTS / Render / VPS / Docker)
# ==============================================================================
# Configurar estas variables en el servidor o servicio persistente:

# 1. Base de Datos y Persistencia
# Ruta absoluta al volumen montado en el contenedor o VPS.
# En producción debe apuntar al disco persistente (ej. /data/alsiz.db). NUNCA en dist/ ni en /tmp.
DATABASE_PATH=./data/alsiz.db

# Ejecutar migraciones en el arranque del servidor (true para dev/local, false para prod con release command)
RUN_MIGRATIONS_ON_STARTUP=true

# Opción B / Fallback a Turso Cloud libSQL (si se utiliza base de datos externa):
TURSO_DATABASE_URL=
TURSO_AUTH_TOKEN=

# 2. Seguridad y Sesiones (OWASP / NIST SP 800-63B)
# OBLIGATORIO EN PRODUCCIÓN: Clave criptográfica para derivación HMAC y tokens.
# Longitud mínima: 32 caracteres de alta entropía.
# Generar con: node -e "console.log(crypto.randomBytes(32).toString('hex'))"
SESSION_SECRET=

# Tiempo de expiración de sesiones en horas (predeterminado: 72)
SESSION_TTL_HOURS=72

# Habilitar confianza en proxy inverso (1 = confía en el primer salto como Vercel/Nginx/Render)
TRUST_PROXY=1

# 3. Servicio de Correo Transaccional (Resend)
# Clave generada en https://resend.com/api-keys (comienza con re_...)
RESEND_API_KEY=

# Dirección de remitente verificada en Resend
RESEND_FROM_EMAIL=

# Correo alternativo para recepción de PINs en pruebas locales (opcional)
FALLBACK_PIN_EMAIL=

# 4. Proveedores de Inteligencia Artificial (Solo en Backend)
# Google Gemini (Google AI Studio https://aistudio.google.com/apikey)
GEMINI_API_KEY=

# DeepSeek API (https://platform.deepseek.com/api_keys)
DEEPSEEK_API_KEY=
DEEPSEEK_MODEL=deepseek-chat
DEEPSEEK_BASE_URL=https://api.deepseek.com/v1

# OpenRouter API (https://openrouter.ai/settings/keys)
OPENROUTER_API_KEY=

# Google Cloud Text-to-Speech (Opcional — voz neuronal para docentes IA)
GOOGLE_TTS_API_KEY=

# 5. Configuración de Red del Servidor
NODE_ENV=development
PORT=3000
APP_URL=http://localhost:3000

# 6. Herramientas de Inicialización (Bootstrap Admin)
# Utilizadas únicamente por "npm run db:bootstrap-admin" para crear el primer administrador:
BOOTSTRAP_ADMIN_EMAIL=
BOOTSTRAP_ADMIN_PASSWORD=
BOOTSTRAP_ADMIN_NAME=
