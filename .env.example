# ==============================================================================
# ARCHIVO DE PLANTILLA DE CONFIGURACIÓN DE ENTORNO (.env.example)
# Plataforma Educativa ALSIZ — Ekballo Church
# ==============================================================================
#
# INSTRUCCIONES DE SEGURIDAD:
# 1. Copie este archivo como `.env.local` para desarrollo local o configure
#    estas variables en el panel de su proveedor de despliegue (ej. Vercel).
# 2. NUNCA incluya contraseñas reales, tokens o claves API en este archivo ni en Git.
# 3. NUNCA use prefijos "VITE_" para secretos de backend; cualquier variable con
#    prefijo "VITE_" será compilada e integrada en el bundle descargable por los usuarios.
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. BASE DE DATOS Y PERSISTENCIA (Turso Cloud libSQL / SQLite Local)
# ------------------------------------------------------------------------------
# Para producción en Vercel, utilice Turso Cloud (plan gratuito recomendado):
# Obtenga estas credenciales ejecutando: turso db show <nombre-bd> y turso db tokens create <nombre-bd>
TURSO_DATABASE_URL=
TURSO_AUTH_TOKEN=

# Para desarrollo local desconectado (fallback automático si TURSO_DATABASE_URL está vacío):
DATABASE_PATH=./data/alsiz.db

# ------------------------------------------------------------------------------
# 2. SEGURIDAD Y SESIONES (OWASP / NIST SP 800-63B)
# ------------------------------------------------------------------------------
# OBLIGATORIO EN PRODUCCIÓN: Clave secreta para derivación de HMAC y tokens.
# Debe tener un mínimo estricto de 32 caracteres y alta entropía criptográfica.
# Genere una clave con: openssl rand -hex 32  o  node -e "console.log(crypto.randomBytes(32).toString('hex'))"
# ¡ADVERTENCIA: El servidor se negará a iniciar en producción si esta clave está vacía, es menor a 32 caracteres o usa valores de ejemplo!
SESSION_SECRET=

# Tiempo de vida de las sesiones activas en horas (predeterminado: 72)
SESSION_TTL_HOURS=72

# ------------------------------------------------------------------------------
# 3. SERVICIO DE CORREO TRANSACCIONAL (Resend / Notificaciones de PIN)
# ------------------------------------------------------------------------------
# Clave API generada en https://resend.com/api-keys (comienza con re_...)
RESEND_API_KEY=

# Dirección de remitente verificada en Resend (ej. "ALSIZ Ekballo <noreply@tudominio.com>" o "onboarding@resend.dev" para pruebas)
RESEND_FROM_EMAIL=

# Correo de contingencia para recepción de PINs en pruebas (opcional)
FALLBACK_PIN_EMAIL=

# ------------------------------------------------------------------------------
# 4. CAPA DE PROVEEDORES LLM (Solo Backend — Cero exposición en frontend)
# ------------------------------------------------------------------------------
# Proveedor 1: Google Gemini (Free Tier de Google AI Studio https://aistudio.google.com/apikey)
GEMINI_API_KEY=

# Proveedor 2: DeepSeek API (https://platform.deepseek.com/api_keys)
DEEPSEEK_API_KEY=
DEEPSEEK_MODEL=deepseek-chat
DEEPSEEK_BASE_URL=https://api.deepseek.com/v1

# Proveedor 3: OpenRouter API (https://openrouter.ai/settings/keys)
OPENROUTER_API_KEY=

# Síntesis de Voz: Google Cloud TTS (Opcional — clave de servidor para voz neuronal)
GOOGLE_TTS_API_KEY=

# ------------------------------------------------------------------------------
# 5. CONFIGURACIÓN DEL SERVIDOR Y RED
# ------------------------------------------------------------------------------
NODE_ENV=development
PORT=3000
APP_URL=http://localhost:3000

# ------------------------------------------------------------------------------
# 6. INICIALIZACIÓN INICIAL DE ADMINISTRADOR (Opcional para scripts de bootstrap)
# ------------------------------------------------------------------------------
# Utilizado únicamente por "npm run db:bootstrap-admin"
BOOTSTRAP_ADMIN_EMAIL=
BOOTSTRAP_ADMIN_PASSWORD=
BOOTSTRAP_ADMIN_NAME=
